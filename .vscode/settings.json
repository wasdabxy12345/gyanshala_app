{
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "cmake.ignoreCMakeListsMissing": true,
  "java.compile.nullAnalysis.mode": "automatic",
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "pubspec\\.yaml$",
        "cmd": "dart run sort_pubspec_dependencies"
      }
    ]
  },
  "[dart]": {
    "editor.formatOnSave": true
  }
}